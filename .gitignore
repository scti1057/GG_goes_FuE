# ROS2 / colcon artifacts
/ros_ws/build/
/ros_ws/install/
/ros_ws/log/
*.log

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.venv/
/ros_ws/.venv/

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Keep workspace source tree trackable
!ros_ws/src/
!ros_ws/src/**

# Re-ignore generated artifacts inside ros_ws/src packages
ros_ws/src/**/build/
ros_ws/src/**/install/
ros_ws/src/**/log/
ros_ws/src/**/__pycache__/
ros_ws/src/**/*.pyc
ros_ws/src/**/*.pyo
ros_ws/src/**/*.pyd
ros_ws/src/**/.pytest_cache/
ros_ws/src/**/.mypy_cache/
ros_ws/src/**/.ruff_cache/
