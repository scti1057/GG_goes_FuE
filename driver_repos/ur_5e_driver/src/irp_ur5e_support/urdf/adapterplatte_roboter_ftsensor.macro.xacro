<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="adapterplatte_roboter_ftsensor">
    <xacro:arg name="s" default="0.001" />

    <link name="adapterplatte_roboter_ftsensor">
    <visual>
        <origin xyz="0 0 0.021" rpy="${-pi/2} 0 0" />
        <geometry>
            <mesh filename="package://pipe2/meshes/adapterplatte_roboter_ftsensor_bin.stl" scale="$(arg s) $(arg s) $(arg s)"/>
        </geometry>
    </visual>
    <collision>
        <origin xyz="0 0 0.021" rpy="${-pi/2} 0 0" />
        <geometry>
            <mesh filename="package://pipe2/meshes/adapterplatte_roboter_ftsensor_bin.stl" scale="$(arg s) $(arg s) $(arg s)"/>
        </geometry>
    </collision>
    </link>

</robot>